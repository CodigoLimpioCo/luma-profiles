<Window x:Class="LumaProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Luma Profiles — Código Limpio" Icon="/Assets/LumaProfiles.ico" Height="920" Width="1540" MinHeight="760" MinWidth="1240"
        WindowStartupLocation="CenterScreen" Background="#090E14" Foreground="#F5F8FB"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Segoe UI Variable Text">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A23"/>
        <SolidColorBrush x:Key="CardBrush" Color="#151F29"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9DAFC0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#55D6F5"/>

        <Style TargetType="Button" x:Key="FlatButton">
            <Setter Property="Foreground" Value="#DCE7F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D2A36"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#253746"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowButton">
            <Setter Property="Foreground" Value="#94A8B7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="51"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#18242E"/>
                                <Setter Property="Foreground" Value="#F1F7FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#21333F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="CloseWindowButton" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C83B4B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#A92D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton" x:Key="NavButton">
            <Setter Property="Foreground" Value="#B8C7D3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Height="44">
                            <Border x:Name="Selection" Background="Transparent" CornerRadius="10"/>
                            <Border x:Name="Indicator" Width="3" Height="22" CornerRadius="2"
                                    Background="#55D6F5" HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <ContentPresenter Margin="13,0,10,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="#16232E"/>
                                <Setter Property="Foreground" Value="#F5FAFD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="#17303B"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="#051016"/>
            <Setter Property="Background" Value="#55D6F5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#83E5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#DCE7F0"/>
            <Setter Property="Background" Value="#22303C"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,5,0,14"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsTabStop="False" Background="#55D6F5" BorderThickness="0" Height="4"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#DDF8FF" Stroke="#55D6F5" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsTabStop="False" Background="#344552" BorderThickness="0" Height="4"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EAF4FA"/>
            <Setter Property="Background" Value="#17232D"/>
            <Setter Property="BorderBrush" Value="#334756"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EAF4FA"/>
                        <Setter Property="Background" Value="#17232D"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#253846"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#1D4855"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#17232D" BorderBrush="#334756" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" TextElement.Foreground="#EAF4FA"/>
                                                <TextBlock Grid.Column="1" Text="⌄" Foreground="#8EA5B6" FontSize="16" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#131E27" BorderBrush="#334756" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="220">
                                    <ScrollViewer MaxHeight="260">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="DestinationComboBox">
            <Setter Property="Foreground" Value="#F2F8FC"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#C8D5DE"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemRoot" Background="Transparent" CornerRadius="9" Padding="10,11" Margin="4,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="35"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="25" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border Width="16" Height="11" CornerRadius="2" BorderBrush="#627989" BorderThickness="1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                <Border Width="16" Height="11" CornerRadius="2" BorderBrush="#7C91A0" BorderThickness="1"
                                                        Background="#101A22" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                            <Border x:Name="Checkmark" Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                                    Background="#1E5966" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Path Data="M 4 10 L 8 14 L 16 6" Stroke="#8AEEFF" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#172A35"/>
                                            <Setter Property="Foreground" Value="#F4FAFD"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#183C47"/>
                                            <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                        <Border x:Name="Field" BorderBrush="#2C424F" BorderThickness="1" CornerRadius="12" Padding="11,7">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#182833" Offset="0"/>
                                                    <GradientStop Color="#111D26" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="39"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="9" Background="#142F3A" BorderBrush="#26505D" BorderThickness="1" VerticalAlignment="Center">
                                                    <Grid Width="24" Height="20">
                                                        <Border Width="16" Height="11" CornerRadius="2" BorderBrush="#55D6F5" BorderThickness="1.2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                        <Border Width="16" Height="11" CornerRadius="2" BorderBrush="#8E79FF" BorderThickness="1.2"
                                                                Background="#142F3A" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                </Border>
                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" TextElement.Foreground="#F2F8FC"
                                                                  TextElement.FontWeight="SemiBold"/>
                                                <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13" Background="#1D303B" HorizontalAlignment="Right">
                                                    <Path x:Name="Chevron" Data="M 1 1 L 5 5 L 9 1"
                                                          Stroke="#9AB0BE" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="Glow" CornerRadius="12" BorderBrush="#55D6F5" BorderThickness="1"
                                                Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="#466572"/>
                                                <Setter TargetName="Glow" Property="Opacity" Value="0.22"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="#55D6F5"/>
                                                <Setter TargetName="Glow" Property="Opacity" Value="0.75"/>
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180" CenterX="5" CenterY="3"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="9"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#101A22" BorderBrush="#2E4553" BorderThickness="1"
                                        CornerRadius="13" Padding="5" MinWidth="225">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="7" Opacity="0.55"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="SELECCIONAR DESTINO" Foreground="#617B8C" FontSize="9" FontWeight="SemiBold" Margin="11,8,11,6"/>
                                        <Border Height="1" Background="#20323E" Margin="6,0,6,3"/>
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EAF4FA"/>
            <Setter Property="Background" Value="#131E27"/>
            <Setter Property="BorderBrush" Value="#2E4250"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CaretBrush" Value="#55D6F5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="36">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3A4C59" CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="365"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0A1118" BorderBrush="#21313E" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#172B37" Margin="0,0,10,0">
                        <Grid>
                            <Ellipse Width="12" Height="12" Fill="#55D6F5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
                            <Ellipse Width="12" Height="12" Fill="#7B65FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Luma Profiles" FontSize="13" FontWeight="SemiBold" Foreground="#EDF7FC" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="#2A3B47" Margin="12,0"/>
                    <TextBlock Text="MONITOR STUDIO" FontSize="9" FontWeight="SemiBold" Foreground="#718A9C" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#0F1B23" BorderBrush="#1D303C" BorderThickness="1" CornerRadius="11" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#54D6A0" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Foreground="#8CA2B1" FontSize="10" VerticalAlignment="Center">
                            <Run Text="CONTROL LOCAL"/><Run Text="  ·  "/><Run Text="{Binding Profiles.Count, Mode=OneWay}"/><Run Text=" PERFILES"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Click="OpenCodigoLimpio_Click"
                        Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Código Limpio" Foreground="#BBD0DC" FontSize="11"/>
                        <TextBlock Text=" ↗" Foreground="#55D6F5" FontSize="11"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click" ToolTip="Minimizar"/>
                    <Button Style="{StaticResource WindowButton}" Content="□" Click="Maximize_Click" ToolTip="Maximizar o restaurar"/>
                    <Button Style="{StaticResource CloseWindowButton}" Content="×" Click="Close_Click" ToolTip="Cerrar"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#0C141C" BorderBrush="#21313E" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <Border Width="46" Height="46" CornerRadius="13" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#55D6F5" Offset="0"/>
                                <GradientStop Color="#725DFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="27" Height="27" Fill="#0C141C" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
                            <Ellipse Width="10" Height="10" Fill="#DDF9FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Luma Profiles" FontSize="19" FontWeight="SemiBold" Foreground="#F4FAFD"/>
                        <TextBlock Text="Monitor Studio" FontSize="11" Foreground="#8198A9"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2" Margin="4,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="BIBLIOTECA" Foreground="#607A8D" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#15232D" CornerRadius="8" Padding="8,3">
                        <TextBlock Text="{Binding Profiles.Count}" Foreground="#8EDFF2" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="4">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="True" Checked="Category_Click" Tag="Todos" Content="▦    Todos los perfiles"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" Checked="Category_Click" Tag="Color fiel" Content="◉    Color fiel"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" Checked="Category_Click" Tag="ASUS GameVisual" Content="◆    ASUS GameVisual"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" Checked="Category_Click" Tag="HDR" Content="◐    HDR"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" Checked="Category_Click" Tag="Color creativo" Content="✦    Color creativo"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" Checked="Category_Click" Tag="Entretenimiento" Content="▶    Entretenimiento"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" Checked="Category_Click" Tag="Rendimiento" Content="ϟ    Rendimiento"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" Checked="Category_Click" Tag="Cuidado visual" Content="◒    Cuidado visual"/>
                </StackPanel>

                <StackPanel Grid.Row="5">
                    <Border Background="#101E27" BorderBrush="#203643" BorderThickness="1" CornerRadius="12" Padding="5" Margin="0,0,0,10">
                        <Button Style="{StaticResource FlatButton}" Click="Repair_Click" ToolTip="Restablece una gamma RGB neutra y elimina dominantes de color." Content="↺    Neutralizar color"/>
                    </Border>
                    <Border Background="#111B24" BorderBrush="#20313D" BorderThickness="1" CornerRadius="12" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#F6F8FA"
                                    BorderBrush="#355060" BorderThickness="1" Padding="3"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Image Source="/Assets/CodigoLimpioLogo.png" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       ToolTip="Código Limpio"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="CREADO POR" Foreground="#607A8D" FontWeight="SemiBold" FontSize="9"/>
                                <TextBlock Text="Código Limpio" Foreground="#E8F7FC" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock Text="Software con intención." Foreground="#7790A2" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Style="{StaticResource FlatButton}" Click="OpenCodigoLimpio_Click" Content="Sitio ↗" Foreground="#55D6F5" Padding="0,4" Margin="0,0,18,0"/>
                                <Button Style="{StaticResource FlatButton}" Click="OpenCodigoLimpioGithub_Click" Content="GitHub ↗" Padding="0,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="24,24,18,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Biblioteca de perfiles" FontSize="31" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Profiles.Count, StringFormat={}{0} modos ajustables para cada momento}" FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Buscar perfiles" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,5"/>
                    <TextBox TextChanged="Search_TextChanged" ToolTip="Busca por nombre, categoría o descripción"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Width="205">
                    <TextBlock Text="DESTINO DE COLOR" Foreground="#7890A1" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,6"/>
                    <ComboBox Style="{StaticResource DestinationComboBox}" ItemsSource="{Binding MonitorTargets}" SelectedItem="{Binding SelectedMonitorTarget}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ProfilesScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding VisibleProfiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="264" Height="340" Margin="0,0,12,14" Padding="11"
                                    Background="{StaticResource CardBrush}" BorderBrush="#263746" BorderThickness="1"
                                    CornerRadius="13" ToolTip="{Binding Description}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#55D6F5"/>
                                                <Setter Property="Background" Value="#192631"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="130"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border CornerRadius="9" ClipToBounds="True" BorderBrush="#385064" BorderThickness="1">
                                        <Grid>
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="/Assets/color-reference.png" Stretch="UniformToFill"
                                                                Viewbox="0.333,0.08,0.333,0.72" ViewboxUnits="RelativeToBoundingBox"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Rectangle Opacity="0.18">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{Binding PreviewStart}" Offset="0"/>
                                                        <GradientStop Color="{Binding PreviewEnd}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Border Background="#9A071018" VerticalAlignment="Bottom" Padding="9,5">
                                                <Grid>
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#DCEAF3"/>
                                                    <TextBlock Text="VISTA PREVIA" FontSize="9" Foreground="#91A8B8" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                            <Border Background="#AA081018" CornerRadius="10" Padding="9,5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="ACTIVO" FontSize="10" FontWeight="Bold" Foreground="#55D6F5"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="2,10,2,8">
                                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Height="45" Margin="0,4,0,8" FontSize="12"/>
                                        <WrapPanel>
                                            <Border Background="#22313D" CornerRadius="6" Padding="8,4" Margin="0,0,6,5">
                                                <TextBlock Foreground="#C7D5E0"><Run Text="Brillo "/><Run Text="{Binding Brightness}" FontWeight="SemiBold"/></TextBlock>
                                            </Border>
                                            <Border Background="#22313D" CornerRadius="6" Padding="8,4" Margin="0,0,6,5">
                                                <TextBlock Foreground="#C7D5E0"><Run Text="Sat. "/><Run Text="{Binding Saturation}" FontWeight="SemiBold"/></TextBlock>
                                            </Border>
                                            <Border Background="#22313D" CornerRadius="6" Padding="8,4" Margin="0,0,6,5">
                                                <TextBlock Foreground="#C7D5E0"><Run Text="γ "/><Run Text="{Binding Gamma, StringFormat={}{0:F2}}" FontWeight="SemiBold"/></TextBlock>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Ajustar" Tag="{Binding}" Click="EditProfile_Click"/>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Aplicar" Tag="{Binding}" Click="ApplyProfile_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#101922" CornerRadius="9" Padding="12,9" Margin="0,6,16,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#9DB2C2"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Background="#0E161F" BorderBrush="#1E2B36" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,28">
                    <TextBlock Text="Ajustar perfil" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="Personaliza el perfil seleccionado. Los cambios afectan la próxima aplicación." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/>

                    <Border Background="#17222C" CornerRadius="9" Padding="13" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedProfile.Category}" Foreground="#55D6F5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="IMAGEN" Foreground="#6E8798" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,11"/>
                    <TextBlock><Run Text="Brillo"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Brightness}" Foreground="#55D6F5"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" Value="{Binding SelectedProfile.Brightness, Mode=TwoWay}"/>
                    <TextBlock><Run Text="Contraste"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Contrast}" Foreground="#55D6F5"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" Value="{Binding SelectedProfile.Contrast, Mode=TwoWay}"/>
                    <TextBlock><Run Text="Gamma"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Gamma, StringFormat={}{0:F2}}" Foreground="#55D6F5"/></TextBlock>
                    <Slider Minimum="0.70" Maximum="1.30" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Gamma, Mode=TwoWay}"/>

                    <Border Height="1" Background="#263744" Margin="0,4,0,16"/>
                    <TextBlock Text="COLOR" Foreground="#6E8798" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>
                    <TextBlock Text="Temperatura de color" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ColorTemperatureOptions}"
                              SelectedItem="{Binding SelectedProfile.ColorTemperature, Mode=TwoWay}" Margin="0,0,0,14"/>
                    <TextBlock><Run Text="Saturación"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Saturation}" Foreground="#55D6F5"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" Value="{Binding SelectedProfile.Saturation, Mode=TwoWay}"/>
                    <TextBlock ToolTip="Algunos modos del monitor bloquean el matiz, igual que ASUS DisplayWidget."><Run Text="Matiz"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Hue}" Foreground="#55D6F5"/></TextBlock>
                    <Slider Minimum="-50" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Hue, Mode=TwoWay}" ToolTip="Disponible únicamente si el modo del monitor permite modificar el matiz."/>

                    <TextBlock Text="Balance RGB personalizado" FontWeight="SemiBold" Margin="0,2,0,10"/>
                    <TextBlock Foreground="#FF7B86"><Run Text="Rojo"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Red, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Red, Mode=TwoWay}"/>
                    <TextBlock Foreground="#68DB98"><Run Text="Verde"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Green, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Green, Mode=TwoWay}"/>
                    <TextBlock Foreground="#6DA3FF"><Run Text="Azul"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Blue, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Blue, Mode=TwoWay}"/>

                    <Border Background="#18253A" BorderBrush="#36537D" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,4,0,10"
                            Visibility="{Binding SelectedProfile.IsHdr, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="HDR requiere activación en Windows" Foreground="#86B7FF" FontWeight="SemiBold"/>
                            <TextBlock Text="Al activar HDR, el monitor bloquea GameVisual y varios controles SDR." Foreground="#A9BBD0" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Abrir configuración HDR" Click="OpenHdrSettings_Click"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Content="Guardar y aplicar" Click="SaveAndApply_Click" Margin="0,10,0,9"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Restaurar valores originales" Click="RestoreDefaults_Click"/>

                    <Border BorderBrush="#29434F" BorderThickness="1" CornerRadius="12" Margin="0,18,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#162A33" Offset="0"/>
                                <GradientStop Color="#101920" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border Width="3" Margin="0,10" CornerRadius="2" Background="#55D6F5" HorizontalAlignment="Left"/>
                            <Grid Margin="15,13,13,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="8" Background="#193945" BorderBrush="#286070" BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="i" Foreground="#7CE5FA" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Precisión de color" Foreground="#EFF8FB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#183641" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock Text="RECOMENDADO" Foreground="#6DDDF4" FontSize="8" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Foreground="#9FB2BF" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0">
                                        <Run Text="Usa "/><Run Text="Natural" Foreground="#DDF8FF" FontWeight="SemiBold"/><Run Text=" o "/><Run Text="Referencia" Foreground="#DDF8FF" FontWeight="SemiBold"/><Run Text=" para trabajo de color. Los perfiles cálidos modifican intencionalmente el balance RGB."/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

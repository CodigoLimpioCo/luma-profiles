                                Command="{Binding DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource PrimaryButton}" Width="74" Padding="4,6" FontSize="12"
                                Content="{Binding DataContext[Apply], RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.HelpText="{Binding DisplayName}"
                                Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>

                    <TextBlock><Run Text="{Binding [Gamma]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Gamma, StringFormat={}{0:F2}}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0.70" Maximum="1.30" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Gamma, Mode=TwoWay}"/>

                    <Border Height="1" Background="{DynamicResource BorderThemeBrush}" Margin="0,4,0,16"/>
                    <TextBlock Text="{Binding [Color]}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [ColorTemperature]}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ColorTemperatureOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedProfile.ColorTemperature, Mode=TwoWay}" Margin="0,0,0,14"/>
                    <TextBlock><Run Text="{Binding [Saturation]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Saturation}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" Value="{Binding SelectedProfile.Saturation, Mode=TwoWay}"/>
                    <TextBlock ToolTip="{Binding [HueTooltip]}"><Run Text="{Binding [Hue]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Hue}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="-50" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Hue, Mode=TwoWay}" ToolTip="{Binding [HueControlTooltip]}"/>

                    <TextBlock Text="{Binding [CustomRgb]}" FontWeight="SemiBold" Margin="0,2,0,10"/>
                    <TextBlock Foreground="#FF7B86"><Run Text="{Binding [Red]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Red, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Red, Mode=TwoWay}"/>
                    <TextBlock Foreground="#68DB98"><Run Text="{Binding [Green]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Green, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Green, Mode=TwoWay}"/>
                    <TextBlock Foreground="#6DA3FF"><Run Text="{Binding [Blue]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Blue, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding SelectedProfile.Blue, Mode=TwoWay}"/>

                    <Border Background="#18253A" BorderBrush="#36537D" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,4,0,10"
                            Visibility="{Binding SelectedProfile.IsHdr, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding [HdrRequires]}" Foreground="#86B7FF" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [HdrDescription]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{Binding [OpenHdr]}" Click="OpenHdrSettings_Click"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding [SaveApply]}" Click="SaveAndApply_Click" Margin="0,10,0,9"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding [RestoreDefaults]}" Click="RestoreDefaults_Click"/>

                    <Border BorderBrush="#29434F" BorderThickness="1" CornerRadius="12" Margin="0,18,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#162A33" Offset="0"/>
                                <GradientStop Color="#101920" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border Width="3" Margin="0,10" CornerRadius="2" Background="#55D6F5" HorizontalAlignment="Left"/>
                            <Grid Margin="15,13,13,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="8" Background="#193945" BorderBrush="#286070" BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="i" Foreground="#7CE5FA" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [ColorAccuracy]}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#183641" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding [Recommended]}" Foreground="{DynamicResource AccentTextBrush}" FontSize="8" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [AccuracyAdvice]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="AboutOverlay" Grid.RowSpan="2" Grid.ColumnSpan="3" Panel.ZIndex="100"
              Background="#B8090E14" Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="20" Padding="0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="12" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="20,20,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#55D6F5" Offset="0"/>
                                <GradientStop Color="#7B65FF" Offset="0.55"/>
                                <GradientStop Color="#D84FA8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Grid.Row="1" Margin="28,25,28,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="16" Background="#FFFFFF" Padding="8">
                                <Image Source="/Assets/LumaProfiles.ico" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                <TextBlock Text="Luma Profiles" FontSize="22" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="7,3">
                                        <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold">
                                            <Run Text="v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="  ·  Windows" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Click="CloseAbout_Click"
                                    Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center"
                                    ToolTip="{Binding [Close]}" AutomationProperties.Name="{Binding [Close]}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding AboutDescription}" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,24,0,20"/>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#FFFFFF" Padding="5">
                                    <Image Source="/Assets/CodigoLimpioLogo.png" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Código Limpio" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding [Intent]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Click="OpenCodigoLimpioGithub_Click"
                                        Padding="10,7" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GitHub" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="  &#xE8A7;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SecondaryButton}" Content="{Binding [Website]}"
                                    Click="OpenCodigoLimpio_Click" Padding="16,10" HorizontalAlignment="Left"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding [Close]}"
                                    Click="CloseAbout_Click" Padding="24,10"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

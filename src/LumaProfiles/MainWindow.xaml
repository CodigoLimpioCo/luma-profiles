                <DataTrigger Binding="{Binding ViewMode}" Value="Compact">
                    <Setter Property="ItemTemplate" Value="{StaticResource CompactTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewMode}" Value="List">
                    <Setter Property="ItemsPanel" Value="{StaticResource StackPanelTemplate}"/>
                    <Setter Property="ItemTemplate" Value="{StaticResource ListTemplate}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewMode}" Value="Details">
                    <Setter Property="ItemsPanel" Value="{StaticResource StackPanelTemplate}"/>
                    <Setter Property="ItemTemplate" Value="{StaticResource DetailsTemplate}"/>

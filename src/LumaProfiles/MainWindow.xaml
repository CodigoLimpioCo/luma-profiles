                                  SelectedValue="{Binding ScheduleNightProfileId, Mode=TwoWay}"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,8,0,0" Text="{Binding ScheduleNightStart, UpdateSourceTrigger=LostFocus}" MaxLength="5"

                                </StackPanel>
                                <TextBlock Text="{Binding [LivePreviewDescription]}" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,4,12,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource LivePreviewToggle}"
                                      IsChecked="{Binding IsLivePreviewEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                      ToolTip="{Binding [LivePreview]}" AutomationProperties.Name="{Binding [LivePreview]}"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="13" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedProfile.DisplayName}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedProfile.DisplayCategory}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding [Image]}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,11"/>
                    <TextBlock><Run Text="{Binding [Brightness]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Brightness}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" AutomationProperties.Name="{Binding [Brightness]}" Value="{Binding SelectedProfile.Brightness, Mode=TwoWay}"/>
                    <TextBlock><Run Text="{Binding [Contrast]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Contrast}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" AutomationProperties.Name="{Binding [Contrast]}" Value="{Binding SelectedProfile.Contrast, Mode=TwoWay}"/>
                    <TextBlock><Run Text="{Binding [Gamma]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Gamma, StringFormat={}{0:F2}}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0.70" Maximum="1.30" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Gamma]}" Value="{Binding SelectedProfile.Gamma, Mode=TwoWay}"/>

                    <Border Height="1" Background="{DynamicResource BorderThemeBrush}" Margin="0,4,0,16"/>
                    <TextBlock Text="{Binding [Color]}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [ColorTemperature]}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ColorTemperatureOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                              AutomationProperties.Name="{Binding [ColorTemperature]}" SelectedValue="{Binding SelectedProfile.ColorTemperature, Mode=TwoWay}" Margin="0,0,0,14"/>
                    <TextBlock><Run Text="{Binding [Saturation]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Saturation}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" AutomationProperties.Name="{Binding [Saturation]}" Value="{Binding SelectedProfile.Saturation, Mode=TwoWay}"/>
                    <TextBlock ToolTip="{Binding [HueTooltip]}"><Run Text="{Binding [Hue]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Hue}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="-50" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Hue]}" Value="{Binding SelectedProfile.Hue, Mode=TwoWay}" ToolTip="{Binding [HueControlTooltip]}"/>

                    <TextBlock Text="{Binding [CustomRgb]}" FontWeight="SemiBold" Margin="0,2,0,10"/>
                    <TextBlock Foreground="#FF7B86"><Run Text="{Binding [Red]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Red, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Red]}" Value="{Binding SelectedProfile.Red, Mode=TwoWay}"/>
                    <TextBlock Foreground="#68DB98"><Run Text="{Binding [Green]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Green, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Green]}" Value="{Binding SelectedProfile.Green, Mode=TwoWay}"/>
                    <TextBlock Foreground="#6DA3FF"><Run Text="{Binding [Blue]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Blue, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Blue]}" Value="{Binding SelectedProfile.Blue, Mode=TwoWay}"/>

                    <Border Background="#18253A" BorderBrush="#36537D" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,4,0,10"
                            Visibility="{Binding SelectedProfile.IsHdr, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding [HdrRequires]}" Foreground="#86B7FF" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [HdrDescription]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{Binding [OpenHdr]}" Command="{Binding OpenHdrSettingsCommand}"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding [SaveApply]}" Command="{Binding SaveAndApplyCommand}" Margin="0,10,0,9"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding [RestoreDefaults]}" Command="{Binding RestoreDefaultsCommand}"/>

                    <Border BorderBrush="#29434F" BorderThickness="1" CornerRadius="12" Margin="0,18,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#162A33" Offset="0"/>
                                <GradientStop Color="#101920" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border Width="3" Margin="0,10" CornerRadius="2" Background="#55D6F5" HorizontalAlignment="Left"/>
                            <Grid Margin="15,13,13,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="8" Background="#193945" BorderBrush="#286070" BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="i" Foreground="#7CE5FA" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [ColorAccuracy]}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#183641" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding [Recommended]}" Foreground="{DynamicResource AccentTextBrush}" FontSize="8" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [AccuracyAdvice]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="SettingsPage" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Panel.ZIndex="50"
              Background="{DynamicResource WindowBrush}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="800" Margin="28,24,28,20" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding CloseSettingsCommand}"
                                Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" Margin="0,0,14,0"
                                ToolTip="{Binding [BackToLibrary]}" AutomationProperties.Name="{Binding [BackToLibrary]}">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Settings]}" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [SettingsDescription]}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding [SettingsGeneral]}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="SemiBold"
                               Margin="4,18,0,8"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [StartWithWindows]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [StartWithWindowsDescription]}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="0,4,16,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource LivePreviewToggle}"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Language]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [LanguageDescription]}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="0,4,16,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource LanguageComboBox}" Width="165"
                              ItemsSource="{Binding Languages}" AutomationProperties.Name="{Binding [Language]}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [DarkMode]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [DarkModeDescription]}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="0,4,16,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource LivePreviewToggle}"
                              IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [MinimizeToTray]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [MinimizeToTrayDescription]}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="0,4,16,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource LivePreviewToggle}"
                              AutomationProperties.Name="{Binding [MinimizeToTray]}"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
                    <TextBlock Text="{Binding [SettingsAutomation]}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="SemiBold"
                               Margin="4,18,0,8"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [GlobalHotkeys]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [GlobalHotkeysDescription]}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="0,4,16,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource LivePreviewToggle}"
                              AutomationProperties.Name="{Binding [GlobalHotkeys]}"
                              IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [Schedule]}" FontWeight="SemiBold"/>

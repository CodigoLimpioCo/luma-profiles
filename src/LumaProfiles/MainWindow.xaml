<Window x:Class="LumaProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Luma Profiles — Código Limpio" Icon="/Assets/LumaProfiles.ico" Height="920" Width="1540" MinHeight="760" MinWidth="1240"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Segoe UI Variable Text" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#090E14"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#0A1118"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0C141C"/>
        <SolidColorBrush x:Key="InspectorBrush" Color="#0E161F"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A23"/>
        <SolidColorBrush x:Key="CardBrush" Color="#151F29"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111B24"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#17222C"/>
        <SolidColorBrush x:Key="InputBrush" Color="#17232D"/>
        <SolidColorBrush x:Key="BorderThemeBrush" Color="#21313E"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#334756"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F8FB"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#DCE7F0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9DAFC0"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#1D2A36"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#17303B"/>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#22303C"/>
        <SolidColorBrush x:Key="ChipBrush" Color="#22313D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#55D6F5"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#8EDFF2"/>

        <Style TargetType="Button" x:Key="FlatButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#253746"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="51"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#18242E"/>
                                <Setter Property="Foreground" Value="#F1F7FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#21333F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="CloseWindowButton" BasedOn="{StaticResource WindowButton}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C83B4B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#A92D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" x:Key="LivePreviewToggle">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="13"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{DynamicResource MutedBrush}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#07141C"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton" x:Key="NavButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Height="44">
                            <Border x:Name="Selection" Background="Transparent" CornerRadius="10"/>
                            <Border x:Name="Indicator" Width="3" Height="22" CornerRadius="2"
                                    Background="#55D6F5" HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <ContentPresenter Margin="13,0,10,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="#051016"/>
            <Setter Property="Background" Value="#55D6F5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#83E5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#07141C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="#07141C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,5,0,14"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsTabStop="False" Background="#55D6F5" BorderThickness="0" Height="4"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#DDF8FF" Stroke="#55D6F5" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsTabStop="False" Background="#344552" BorderThickness="0" Height="4"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#253846"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#1D4855"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" TextElement.Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="⌄" Foreground="#8EA5B6" FontSize="16" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="220">
                                    <ScrollViewer MaxHeight="260">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="LanguageComboBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="LanguageItem" Background="Transparent" CornerRadius="8" Padding="8,7" Margin="3,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="27" Height="22" CornerRadius="6" Background="{DynamicResource ChipBrush}"
                                                    BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Code}" Foreground="{DynamicResource MutedBrush}" FontSize="9"
                                                           FontWeight="Bold" TextOptions.TextFormattingMode="Display"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <Border x:Name="LanguageCheck" Grid.Column="2" Width="18" Height="18" CornerRadius="9"
                                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" HorizontalAlignment="Right">
                                                <Path Data="M 4 9 L 7.5 12.5 L 14 5.5" Stroke="#07141C" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="LanguageItem" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="LanguageItem" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                            <Setter TargetName="LanguageCheck" Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border x:Name="LanguageField" Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="5,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource SelectedBrush}">
                                                        <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ContentPresenter Grid.Column="1" Margin="6,0,4,0"
                                                                      Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      VerticalAlignment="Center" TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
                                                                      TextElement.FontSize="11" TextElement.FontWeight="SemiBold"/>
                                                    <Border Grid.Column="2" Width="22" Height="22" CornerRadius="7"
                                                            Background="{DynamicResource ChipBrush}" HorizontalAlignment="Right">
                                                        <Path x:Name="LanguageChevron" Data="M 2 3 L 6 7 L 10 3"
                                                              Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="LanguageGlow" CornerRadius="10" BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="LanguageField" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                                <Setter TargetName="LanguageGlow" Property="Opacity" Value="0.28"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="LanguageField" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="LanguageGlow" Property="Opacity" Value="0.45"/>
                                                <Setter TargetName="LanguageChevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="6"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Slide">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1" CornerRadius="11" Padding="4" MinWidth="190">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.35" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="DestinationComboBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#C8D5DE"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemRoot" Background="Transparent" CornerRadius="9" Padding="10,11" Margin="4,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="35"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="25" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border Width="16" Height="11" CornerRadius="2" BorderBrush="#627989" BorderThickness="1"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                <Border Width="16" Height="11" CornerRadius="2" BorderBrush="#7C91A0" BorderThickness="1"
                                                        Background="#101A22" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                            <Border x:Name="Checkmark" Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                                    Background="#1E5966" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Path Data="M 4 10 L 8 14 L 16 6" Stroke="#8AEEFF" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#172A35"/>
                                            <Setter Property="Foreground" Value="#F4FAFD"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#183C47"/>
                                            <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                        <Border x:Name="Field" BorderBrush="#2C424F" BorderThickness="1" CornerRadius="12" Padding="11,7">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#182833" Offset="0"/>
                                                    <GradientStop Color="#111D26" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="39"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="9" Background="#142F3A" BorderBrush="#26505D" BorderThickness="1" VerticalAlignment="Center">
                                                    <Grid Width="24" Height="20">
                                                        <Border Width="16" Height="11" CornerRadius="2" BorderBrush="#55D6F5" BorderThickness="1.2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                        <Border Width="16" Height="11" CornerRadius="2" BorderBrush="#8E79FF" BorderThickness="1.2"
                                                                Background="#142F3A" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                </Border>
                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" TextElement.Foreground="#F2F8FC"
                                                                  TextElement.FontWeight="SemiBold"/>
                                                <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13" Background="#1D303B" HorizontalAlignment="Right">
                                                    <Path x:Name="Chevron" Data="M 1 1 L 5 5 L 9 1"
                                                          Stroke="#9AB0BE" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="Glow" CornerRadius="12" BorderBrush="#55D6F5" BorderThickness="1"
                                                Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="#466572"/>
                                                <Setter TargetName="Glow" Property="Opacity" Value="0.22"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="#55D6F5"/>
                                                <Setter TargetName="Glow" Property="Opacity" Value="0.75"/>
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180" CenterX="5" CenterY="3"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="9"

                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewRuleProcess, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding [AppRuleProcess]}" AutomationProperties.Name="{Binding [AppRuleProcess]}"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                  AutomationProperties.Name="{Binding [Profiles]}" SelectedValue="{Binding NewRuleProfileId, Mode=TwoWay}"/>
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="{Binding [AppRuleAdd]}"
                                Command="{Binding AddAppRuleCommand}" Padding="14,8"/>
                    </Grid>
                </StackPanel>
            </Border>
                    <TextBlock Text="{Binding [SettingsData]}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="SemiBold"
                               Margin="4,18,0,8"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="15,13" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [OriginalDisplayState]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [OriginalDisplayStateDescription]}" Foreground="{DynamicResource MutedBrush}"

                                            ToolTip="{Binding DataContext[ScheduleRemove], RelativeSource={RelativeSource AncestorType=Window}}"
                                            AutomationProperties.Name="{Binding DataContext[ScheduleRemove], RelativeSource={RelativeSource AncestorType=Window}}"
                                            AutomationProperties.HelpText="{Binding Label}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ScheduleKindOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                  AutomationProperties.Name="{Binding [ScheduleKind]}" SelectedValue="{Binding NewScheduleKind, Mode=TwoWay}"/>
                        <TextBox Grid.Column="2" Text="{Binding NewScheduleTime, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" HorizontalContentAlignment="Center"
                                 Visibility="{Binding NewScheduleIsFixed, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="{Binding [ScheduleTime]}" AutomationProperties.Name="{Binding [ScheduleTime]}"/>
                        <TextBox Grid.Column="2" Text="{Binding NewScheduleOffset, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" HorizontalContentAlignment="Center"
                                 Visibility="{Binding NewScheduleIsSun, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="{Binding [ScheduleOffset]}" AutomationProperties.Name="{Binding [ScheduleOffset]}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                  AutomationProperties.Name="{Binding [Profiles]}" SelectedValue="{Binding NewScheduleProfileId, Mode=TwoWay}"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{Binding [ScheduleAdd]}"
                                Command="{Binding AddScheduleEntryCommand}" Padding="14,8"/>
                    </Grid>
                    <TextBlock Text="{Binding [ScheduleLocation]}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding [ScheduleLocationDescription]}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ScheduleLatitude, UpdateSourceTrigger=LostFocus}" MaxLength="9"
                                 ToolTip="{Binding [ScheduleLatitude]}" AutomationProperties.Name="{Binding [ScheduleLatitude]}"/>
                        <TextBox Grid.Column="2" Text="{Binding ScheduleLongitude, UpdateSourceTrigger=LostFocus}" MaxLength="10"
                                 ToolTip="{Binding [ScheduleLongitude]}" AutomationProperties.Name="{Binding [ScheduleLongitude]}"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding [ScheduleTransition]}" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="{Binding [ScheduleTransitionDescription]}" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding TransitionOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Seconds"
                                  AutomationProperties.Name="{Binding [ScheduleTransition]}" SelectedValue="{Binding ScheduleTransitionSeconds, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            
                        <Border Height="1" Background="{DynamicResource BorderThemeBrush}" Margin="0,18"/>
                <StackPanel>
                    <TextBlock Text="{Binding [AppRules]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding [AppRulesDescription]}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="10" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding AppRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ProcessName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  →  "/><Run Text="{Binding ProfileName, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </TextBlock>
                                    <Button Grid.Column="1" Style="{StaticResource FlatButton}" Width="28" Height="28" Padding="0"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding DataContext.RemoveAppRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DataContext[AppRuleRemove], RelativeSource={RelativeSource AncestorType=Window}}"
                                            AutomationProperties.Name="{Binding DataContext[AppRuleRemove], RelativeSource={RelativeSource AncestorType=Window}}"
                                            AutomationProperties.HelpText="{Binding ProcessName}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewRuleProcess, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding [AppRuleProcess]}" AutomationProperties.Name="{Binding [AppRuleProcess]}"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                  AutomationProperties.Name="{Binding [Profiles]}" SelectedValue="{Binding NewRuleProfileId, Mode=TwoWay}"/>
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="{Binding [AppRuleAdd]}"
                                Command="{Binding AddAppRuleCommand}" Padding="14,8"/>
                    </Grid>
                </StackPanel>
            
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsSectionData, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [OriginalDisplayState]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [OriginalDisplayStateDescription]}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="0,4,16,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="{Binding [RestoreOriginalDisplayState]}"
                            Command="{Binding RestoreOriginalCommand}" Padding="14,8" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderThemeBrush}" Margin="0,18"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [RestorePointTitle]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RestorePointText}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding [RestorePointSaveDesc]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding [RestorePointSave]}"
                            Command="{Binding SaveRestorePointCommand}" Padding="14,8" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource BorderThemeBrush}" Margin="0,18"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [ResetStateTitle]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [ResetStateDesc]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding [ResetStateButton]}"
                            Command="{Binding ResetDisplayStateCommand}" Padding="14,8" VerticalAlignment="Center"/>
                </Grid>

                        <Border Height="1" Background="{DynamicResource BorderThemeBrush}" Margin="0,18"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding [ProfilesData]}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [ProfilesDataDescription]}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" Margin="0,4,16,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding [ExportProfiles]}"
                            Command="{Binding ExportProfilesCommand}" Padding="14,8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{Binding [ImportProfiles]}"
                            Command="{Binding ImportProfilesCommand}" Padding="14,8" VerticalAlignment="Center"/>
                </Grid>
            
                        </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="12,9" Margin="28,14,28,16">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="64" Height="3" Margin="0,0,12,0" VerticalAlignment="Center" IsIndeterminate="True"
                                 BorderThickness="0" Background="{DynamicResource BorderThemeBrush}" Foreground="{DynamicResource AccentBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Panel.ZIndex="190" VerticalAlignment="Top" Height="3"
                     IsIndeterminate="True" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>

        <Border x:Name="ConfirmBanner" Grid.Row="1" Grid.ColumnSpan="3" Panel.ZIndex="200" MaxWidth="600" Margin="16,14,16,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Padding="18,14,18,12" CornerRadius="16"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsConfirmationPending, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.LiveSetting="Assertive">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [ConfirmTitle]}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ConfirmDetail, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ConfirmCountdownText, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding [ConfirmRevert]}" Command="{Binding RevertChangesCommand}"
                                Padding="16,9" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding [ConfirmKeep]}" Command="{Binding KeepChangesCommand}"
                                Padding="18,9"/>
                    </StackPanel>
                </Grid>
                <ProgressBar Height="4" Margin="0,12,0,0" Minimum="0" Maximum="{Binding ConfirmTotalSeconds, Mode=OneWay}"
                             Value="{Binding ConfirmRemainingSeconds, Mode=OneWay}" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderThemeBrush}"/>
            </StackPanel>
        </Border>

        <Grid x:Name="AboutOverlay" Grid.RowSpan="2" Grid.ColumnSpan="3" Panel.ZIndex="100"
              Background="#B8090E14" Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="520" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="20" Padding="0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="12" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="20,20,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#55D6F5" Offset="0"/>
                                <GradientStop Color="#7B65FF" Offset="0.55"/>
                                <GradientStop Color="#D84FA8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Grid.Row="1" Margin="28,25,28,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="16" Background="#FFFFFF" Padding="8">
                                <Image Source="/Assets/LumaProfiles.ico" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,2,0,0">
                                <TextBlock Text="Luma Profiles" FontSize="22" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="7,3">
                                        <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold">
                                            <Run Text="v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="  ·  Windows" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Command="{Binding CloseAboutCommand}"
                                    Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center"
                                    ToolTip="{Binding [Close]}" AutomationProperties.Name="{Binding [Close]}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding AboutDescription}" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,24,0,20"/>

                        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#FFFFFF" Padding="5">
                                    <Image Source="/Assets/CodigoLimpioLogo.png" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Código Limpio" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding [Intent]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/CodigoLimpioCo/luma-profiles"
                                        Padding="10,7" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GitHub" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="  &#xE8A7;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SecondaryButton}" Content="{Binding [Website]}"
                                    Command="{Binding OpenUrlCommand}" CommandParameter="https://codigolimpio.com.co/" Padding="16,10" HorizontalAlignment="Left"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding [Close]}"
                                    Command="{Binding CloseAboutCommand}" Padding="24,10"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

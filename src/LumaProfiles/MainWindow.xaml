<Window x:Class="LumaProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:LumaProfiles.Controls"
        xmlns:svc="clr-namespace:LumaProfiles.Services"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Luma Profiles — Código Limpio" Icon="/Assets/LumaProfiles.ico" Height="820" Width="1280" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Segoe UI Variable Text" PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            <ResourceDictionary Source="Themes/ControlStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="AccentBrush" Color="#55D6F5"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#83E5FA"/>
        <ScaleTransform x:Key="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        <sys:Double x:Key="ScrollThumbWidth">7</sys:Double>
        <sys:Double x:Key="ScrollBarTrackWidth">13</sys:Double>

      </ResourceDictionary>
    </Window.Resources>

    <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftSidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RightInspectorColumn" Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#172B37" Margin="0,0,10,0">
                        <Grid>
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
                            <Ellipse Width="12" Height="12" Fill="#7B65FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Luma Profiles" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="{DynamicResource BorderThemeBrush}" Margin="12,0"/>
                    <TextBlock x:Name="BrandSubtitle" Text="{Binding [MonitorStudio]}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="TitleStatus" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="11" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#54D6A0" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center">
                            <Run Text="{Binding [LocalControl]}"/><Run Text="  ·  "/><Run Text="{Binding Profiles.Count, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding [Profiles]}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource FlatButton}" Click="ToggleLeftPanel_Click" Padding="0" Margin="0,0,6,0"
                            Width="36" Height="36" HorizontalContentAlignment="Center"
                            ToolTip="{Binding LeftPanelTooltip}" AutomationProperties.Name="{Binding LeftPanelTooltip}">
                        <Border Width="34" Height="34" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="10">
                            <TextBlock Text="&#xE89F;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="ToggleRightPanel_Click" Padding="0" Margin="0,0,6,0"
                            Width="36" Height="36" HorizontalContentAlignment="Center"
                            ToolTip="{Binding RightPanelTooltip}" AutomationProperties.Name="{Binding RightPanelTooltip}">
                        <Border Width="34" Height="34" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="10">
                            <TextBlock Text="&#xE8A0;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding ToggleThemeCommand}" Padding="3"
                            HorizontalContentAlignment="Center" ToolTip="{Binding ThemeLabel}"
                            AutomationProperties.Name="{Binding ThemeLabel}">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="3">
                            <Grid Width="58" Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                                        <Setter Property="Foreground" Value="#07141C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                        <Setter Property="Foreground" Value="#07141C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </Button>
                    <ComboBox x:Name="TitleLanguageSelector" Style="{StaticResource LanguageComboBox}" Width="148" Margin="6,0,0,0"
                              ItemsSource="{Binding Languages}" AutomationProperties.Name="{Binding [Language]}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding OpenSettingsCommand}" Padding="0" Margin="6,0,0,0"
                            Width="36" Height="36" HorizontalContentAlignment="Center"
                            ToolTip="{Binding [Settings]}" AutomationProperties.Name="{Binding [Settings]}">
                        <Border Width="34" Height="34" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="10">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                </StackPanel>

                <Button x:Name="TitleWebsiteButton" Grid.Column="3" Style="{StaticResource FlatButton}" Command="{Binding OpenUrlCommand}" CommandParameter="https://codigolimpio.com.co/"
                        Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Código Limpio" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                        <TextBlock Text=" ↗" Foreground="{DynamicResource AccentTextBrush}" FontSize="11"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click" ToolTip="{Binding [Minimize]}" AutomationProperties.Name="{Binding [Minimize]}"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="{Binding MaximizeGlyph}"
                            FontFamily="Segoe Fluent Icons" FontSize="16" Click="Maximize_Click" ToolTip="{Binding MaximizeTooltip}" AutomationProperties.Name="{Binding MaximizeTooltip}"/>
                    <Button Style="{StaticResource CloseWindowButton}" Content="×" AutomationProperties.Name="{Binding [Close]}" Click="Close_Click" ToolTip="{Binding [Close]}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="LeftSidebar" Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="18,22,18,18"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Margin" Value="12,22,12,18"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <Border Width="46" Height="46" CornerRadius="13" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#55D6F5" Offset="0"/>
                                <GradientStop Color="#725DFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="27" Height="27" Fill="{DynamicResource SidebarBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
                            <Ellipse Width="10" Height="10" Fill="#DDF9FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Luma Profiles" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Monitor Studio" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2" Margin="4,0" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Library]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="8,3">
                        <TextBlock Text="{Binding Profiles.Count}" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Todos}" Tag="Todos" Checked="Category_Checked" ToolTip="{Binding [AllProfiles]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [AllProfiles]}"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [AllProfiles]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Favoritos}" Tag="Favoritos" Checked="Category_Checked" ToolTip="{Binding [Favorites]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [Favorites]}"><StackPanel Orientation="Horizontal"><TextBlock Text="★" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [Favorites]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Color fiel}" Tag="Color fiel" Checked="Category_Checked" ToolTip="{Binding [FaithfulColor]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [FaithfulColor]}"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [FaithfulColor]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=ASUS GameVisual}" Tag="ASUS GameVisual" Checked="Category_Checked" ToolTip="ASUS GameVisual" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="ASUS GameVisual"><StackPanel Orientation="Horizontal"><TextBlock Text="◆" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="ASUS GameVisual" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=HDR}" Tag="HDR" Checked="Category_Checked" ToolTip="HDR" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="HDR"><StackPanel Orientation="Horizontal"><TextBlock Text="◐" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="HDR" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Color creativo}" Tag="Color creativo" Checked="Category_Checked" ToolTip="{Binding [CreativeColor]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [CreativeColor]}"><StackPanel Orientation="Horizontal"><TextBlock Text="✦" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [CreativeColor]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Entretenimiento}" Tag="Entretenimiento" Checked="Category_Checked" ToolTip="{Binding [Entertainment]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [Entertainment]}"><StackPanel Orientation="Horizontal"><TextBlock Text="▶" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [Entertainment]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Rendimiento}" Tag="Rendimiento" Checked="Category_Checked" ToolTip="{Binding [Performance]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [Performance]}"><StackPanel Orientation="Horizontal"><TextBlock Text="ϟ" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [Performance]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Gamer}" Tag="Gamer" Checked="Category_Checked" ToolTip="{Binding [Gamer]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [Gamer]}"><StackPanel Orientation="Horizontal"><TextBlock Text="🎮" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [Gamer]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Cuidado visual}" Tag="Cuidado visual" Checked="Category_Checked" ToolTip="{Binding [EyeCare]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [EyeCare]}"><StackPanel Orientation="Horizontal"><TextBlock Text="◒" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [EyeCare]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Pantallas VA}" Tag="Pantallas VA" Checked="Category_Checked" ToolTip="{Binding [VaScreens]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [VaScreens]}"><StackPanel Orientation="Horizontal"><TextBlock Text="▥" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [VaScreens]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Categories" IsChecked="{Binding SidebarCategory, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Personalizados}" Tag="Personalizados" Checked="Category_Checked" ToolTip="{Binding [CustomProfiles]}" ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}" AutomationProperties.Name="{Binding [CustomProfiles]}"><StackPanel Orientation="Horizontal"><TextBlock Text="✎" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [CustomProfiles]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="5">
                    <Button Style="{StaticResource SidebarFlatButton}" Command="{Binding ToggleSidebarCollapseCommand}" Margin="0,0,0,10"
                            Visibility="{Binding IsSidebarToggleAvailable, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding SidebarToggleLabel}" AutomationProperties.Name="{Binding SidebarToggleLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SidebarToggleGlyph}" FontFamily="Segoe Fluent Icons" FontSize="13" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SidebarToggleLabel}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="12" Padding="5" Margin="0,0,0,10">
                        <Button Style="{StaticResource SidebarFlatButton}" Command="{Binding RepairCommand}" ToolTip="{Binding [RepairTooltip]}" AutomationProperties.Name="{Binding [Neutralize]}"><StackPanel Orientation="Horizontal"><TextBlock Text="↺" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding [Neutralize]}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/></StackPanel></Button>
                    </Border>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Padding" Value="12,10"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Padding" Value="8,10"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#F6F8FA"
                                    BorderBrush="#355060" BorderThickness="1" Padding="3"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Image Source="/Assets/CodigoLimpioLogo.png" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       ToolTip="Código Limpio"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="{Binding [CreatedBy]}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="9" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource ChipBrush}" CornerRadius="6" Padding="6,2">
                                        <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="9" FontWeight="SemiBold"><Run Text="v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/></TextBlock>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Código Limpio" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding [Intent]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,9,0,0" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource FlatButton}" Command="{Binding OpenUrlCommand}" CommandParameter="https://codigolimpio.com.co/" Content="{Binding [Website]}" Foreground="{DynamicResource AccentTextBrush}" Padding="0,4" Margin="0,0,13,0"/>
                                <Button Style="{StaticResource FlatButton}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/CodigoLimpioCo/luma-profiles" Content="GitHub ↗" Padding="0,4" Margin="0,0,13,0"/>
                                <Button Style="{StaticResource FlatButton}" Command="{Binding OpenAboutCommand}" Content="{Binding [About]}" Padding="0,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Thumb x:Name="SidebarResizer" Grid.Row="1" Grid.Column="0" Panel.ZIndex="60" Width="10" Margin="0,0,-5,0"
               HorizontalAlignment="Right" Style="{StaticResource ResizeHandle}"
               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"
               ToolTip="{Binding [SidebarResizeHint]}" AutomationProperties.Name="{Binding [SidebarResizeHint]}"
               DragDelta="SidebarResizer_DragDelta" DragCompleted="SidebarResizer_DragCompleted"
               MouseDoubleClick="SidebarResizer_DoubleClick" KeyDown="SidebarResizer_KeyDown"/>

        <Grid Grid.Row="1" Grid.Column="1" Margin="18,20,14,16">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ProfileLibrary]}" FontSize="31" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ProfileCountSubtitle}" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding [ColorTarget]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,6"/>
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="19" Padding="3" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasMultipleDisplays, Converter={StaticResource BoolToVisibility}}">
                                <ToggleButton Style="{StaticResource SegmentToggle}" Content="{Binding [MonitorAll]}"
                                              IsChecked="{Binding IsAllDisplaysSelected, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding [MonitorAll]}"/>
                                <ItemsControl ItemsSource="{Binding DisplayButtons}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource SegmentToggle}" Content="{Binding Label}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource BorderStrongBrush}"/>
                            </StackPanel>
                            <Button Style="{StaticResource IdentifyButton}" Command="{Binding IdentifyDisplaysCommand}"
                                    ToolTip="{Binding [MonitorIdentify]}" AutomationProperties.Name="{Binding [MonitorIdentify]}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [MonitorIdentifyShort]}" Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,14,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchTextBox}" Tag="{Binding [SearchProfiles]}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [SearchProfiles]}" ToolTip="{Binding [SearchTooltip]}"/>
                    <ToggleButton Grid.Column="1" Style="{StaticResource FilterToggle}" Margin="10,0,0,0"
                                  IsChecked="{Binding IsFilterPanelOpen, Mode=TwoWay}"
                                  ToolTip="{Binding [FilterTitle]}" AutomationProperties.Name="{Binding [FilterTitle]}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [FilterButton]}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="18" Height="18" Margin="8,0,0,0" Padding="5,0"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ActiveFilterCount}" FontSize="10" FontWeight="Bold" Foreground="#051016"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                </Grid>
                <Border Grid.Row="1" Grid.Column="1" Margin="10,14,0,12" Height="38" Padding="3" HorizontalAlignment="Right"
                        Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="19">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewCards, Mode=TwoWay}" ToolTip="{Binding [ViewCards]}" AutomationProperties.Name="{Binding [ViewCards]}"><Viewbox Width="15" Height="15"><Path Data="M1,1H7V7H1Z M9,1H15V7H9Z M1,9H7V15H1Z M9,9H15V15H9Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewLarge, Mode=TwoWay}" ToolTip="{Binding [ViewLarge]}" AutomationProperties.Name="{Binding [ViewLarge]}"><Viewbox Width="15" Height="15"><Path Data="M1,1H7V15H1Z M9,1H15V15H9Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewCompact, Mode=TwoWay}" ToolTip="{Binding [ViewCompact]}" AutomationProperties.Name="{Binding [ViewCompact]}"><Viewbox Width="15" Height="15"><Path Data="M1,1H5V5H1Z M6,1H10V5H6Z M11,1H15V5H11Z M1,6H5V10H1Z M6,6H10V10H6Z M11,6H15V10H11Z M1,11H5V15H1Z M6,11H10V15H6Z M11,11H15V15H11Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewList, Mode=TwoWay}" ToolTip="{Binding [ViewList]}" AutomationProperties.Name="{Binding [ViewList]}"><Viewbox Width="15" Height="15"><Path Data="M1,2.5H3.5V5H1Z M5.5,2.5H15V5H5.5Z M1,7H3.5V9.5H1Z M5.5,7H15V9.5H5.5Z M1,11.5H3.5V14H1Z M5.5,11.5H15V14H5.5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewDetails, Mode=TwoWay}" ToolTip="{Binding [ViewDetails]}" AutomationProperties.Name="{Binding [ViewDetails]}"><Viewbox Width="15" Height="15"><Path Data="M1,1H15V3.5H1Z M1,5.5H15V8H1Z M1,9.5H15V12H1Z M1,13H15V15H1Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                    </StackPanel>
                </Border>
            <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12" Padding="20,16,20,14" CornerRadius="16"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1"
                    Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [FilterCategories]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding CategoryChips}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding Caption}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="16"/>
                                <TextBlock Text="{Binding [FilterStatus]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding [Favorites]}" IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"/>
                                    <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding [FilterHdr]}" IsChecked="{Binding HdrOnly, Mode=TwoWay}"/>
                                    <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding [FilterHighPerformance]}" IsChecked="{Binding HighPerformanceOnly, Mode=TwoWay}"/>
                                    <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding [FilterModified]}" IsChecked="{Binding ModifiedOnly, Mode=TwoWay}"/>
                                </WrapPanel>
                                <Border Height="16"/>
                                <TextBlock Text="{Binding [ColorTemperature]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding TemperatureChips}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource FilterChip}" Content="{Binding Caption}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [FilterRanges]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [Brightness]}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BrightnessRange.Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BrightnessRange.Min, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding [Brightness]}" AutomationProperties.HelpText="min"/>
                                        <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BrightnessRange.Max, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding [Brightness]}" AutomationProperties.HelpText="max"/>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [Contrast]}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ContrastRange.Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ContrastRange.Min, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding [Contrast]}" AutomationProperties.HelpText="min"/>
                                        <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ContrastRange.Max, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding [Contrast]}" AutomationProperties.HelpText="max"/>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [Saturation]}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SaturationRange.Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SaturationRange.Min, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding [Saturation]}" AutomationProperties.HelpText="min"/>
                                        <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SaturationRange.Max, Mode=TwoWay}"
                                                AutomationProperties.Name="{Binding [Saturation]}" AutomationProperties.HelpText="max"/>
                                    </Grid>
                                </Grid>
                                <Border Height="4"/>
                                <TextBlock Text="{Binding [FilterSort]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding SortOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                          AutomationProperties.Name="{Binding [FilterSort]}"
                                          SelectedValue="{Binding SortMode, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProfileCountSubtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding [FilterClear]}"
                                Command="{Binding ClearFiltersCommand}" Padding="16,8"/>
                    </Grid>
                </Grid>
            </Border>
            </Grid>

            <ScrollViewer x:Name="ProfilesScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="8,0" Margin="0,0,0,6" Height="30">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="Details">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="96"/><ColumnDefinition Width="54"/><ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="60"/><ColumnDefinition Width="46"/><ColumnDefinition Width="156"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Text="{Binding [ColumnProfile]}" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="3" Text="{Binding [ColumnCategory]}" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="4" Text="{Binding [Brightness]}" Style="{StaticResource ColumnHeader}" TextAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding [Contrast]}" Style="{StaticResource ColumnHeader}" TextAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{Binding [Saturation]}" Style="{StaticResource ColumnHeader}" TextAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="{Binding [Gamma]}" Style="{StaticResource ColumnHeader}" TextAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding VisibleProfiles}" Style="{StaticResource ProfilesItemsStyle}"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"
                        Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding [FilterNoResults]}" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
                <Button Style="{StaticResource SecondaryButton}" Content="{Binding [FilterClear]}" Command="{Binding ClearFiltersCommand}"
                        Padding="20,9" Margin="0,14,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="12,9" Margin="0,6,16,0">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="64" Height="3" Margin="0,0,12,0" VerticalAlignment="Center" IsIndeterminate="True"
                                 BorderThickness="0" Background="{DynamicResource BorderThemeBrush}" Foreground="{DynamicResource AccentBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="RightInspector" Grid.Row="1" Grid.Column="2" Background="{DynamicResource InspectorBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,24">
                    <TextBlock Text="{Binding [AdjustProfile]}" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding [CustomizeProfile]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding [LivePreview]}" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [LivePreviewDescription]}" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,4,12,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource LivePreviewToggle}"
                                      IsChecked="{Binding IsLivePreviewEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                      ToolTip="{Binding [LivePreview]}" AutomationProperties.Name="{Binding [LivePreview]}"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="13" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedProfile.DisplayName}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedProfile.DisplayCategory}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,3,0,0"/>
                            <TextBox Margin="0,10,0,0" Text="{Binding SelectedProfile.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MaxLength="40"
                                     Visibility="{Binding SelectedProfileIsCustom, Converter={StaticResource BoolToVisibility}}"
                                     ToolTip="{Binding [CustomProfileName]}" AutomationProperties.Name="{Binding [CustomProfileName]}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding [Image]}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,11"/>
                    <TextBlock><Run Text="{Binding [Brightness]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Brightness}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" AutomationProperties.Name="{Binding [Brightness]}" Value="{Binding SelectedProfile.Brightness, Mode=TwoWay}"/>
                    <TextBlock><Run Text="{Binding [Contrast]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Contrast}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" AutomationProperties.Name="{Binding [Contrast]}" Value="{Binding SelectedProfile.Contrast, Mode=TwoWay}"/>
                    <TextBlock><Run Text="{Binding [Gamma]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Gamma, StringFormat={}{0:F2}}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0.70" Maximum="1.30" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Gamma]}" Value="{Binding SelectedProfile.Gamma, Mode=TwoWay}"/>

                    <Border Height="1" Background="{DynamicResource BorderThemeBrush}" Margin="0,4,0,16"/>
                    <TextBlock Text="{Binding [Color]}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [ColorTemperature]}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ColorTemperatureOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                              AutomationProperties.Name="{Binding [ColorTemperature]}" SelectedValue="{Binding SelectedProfile.ColorTemperature, Mode=TwoWay}" Margin="0,0,0,14"/>
                    <TextBlock><Run Text="{Binding [Saturation]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Saturation}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="0" Maximum="100" AutomationProperties.Name="{Binding [Saturation]}" Value="{Binding SelectedProfile.Saturation, Mode=TwoWay}"/>
                    <TextBlock ToolTip="{Binding [HueTooltip]}"><Run Text="{Binding [Hue]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Hue}" Foreground="{DynamicResource AccentTextBrush}"/></TextBlock>
                    <Slider Minimum="-50" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Hue]}" Value="{Binding SelectedProfile.Hue, Mode=TwoWay}" ToolTip="{Binding [HueControlTooltip]}"/>

                    <TextBlock Text="{Binding [CustomRgb]}" FontWeight="SemiBold" Margin="0,2,0,10"/>
                    <TextBlock Foreground="#FF7B86"><Run Text="{Binding [Red]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Red, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Red]}" Value="{Binding SelectedProfile.Red, Mode=TwoWay}"/>
                    <TextBlock Foreground="#68DB98"><Run Text="{Binding [Green]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Green, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Green]}" Value="{Binding SelectedProfile.Green, Mode=TwoWay}"/>
                    <TextBlock Foreground="#6DA3FF"><Run Text="{Binding [Blue]}"/><Run Text="  "/><Run Text="{Binding SelectedProfile.Blue, StringFormat={}{0:F2}}"/></TextBlock>
                    <Slider Minimum="0.50" Maximum="1.10" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="{Binding [Blue]}" Value="{Binding SelectedProfile.Blue, Mode=TwoWay}"/>

                    <Border Background="#18253A" BorderBrush="#36537D" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,4,0,10"
                            Visibility="{Binding SelectedProfile.IsHdr, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding [HdrRequires]}" Foreground="#86B7FF" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [HdrDescription]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{Binding [OpenHdr]}" Command="{Binding OpenHdrSettingsCommand}"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding [SaveApply]}" Command="{Binding SaveAndApplyCommand}" Margin="0,10,0,9"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding [RestoreDefaults]}" Command="{Binding RestoreDefaultsCommand}"
                            Visibility="{Binding SelectedProfileIsBuiltIn, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding [DeleteCustomProfile]}" Command="{Binding DeleteCustomProfileCommand}"
                            Visibility="{Binding SelectedProfileIsCustom, Converter={StaticResource BoolToVisibility}}"/>

                    <Border Height="1" Background="{DynamicResource BorderThemeBrush}" Margin="0,16,0,14"/>
                    <TextBlock Text="{Binding [SaveAsNewProfile]}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Text="{Binding [SaveAsNewProfileDescription]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,0,0,8"
                             ToolTip="{Binding [CustomProfileName]}" AutomationProperties.Name="{Binding [CustomProfileName]}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding [SaveAsNewProfile]}" Command="{Binding SaveAsNewProfileCommand}"/>

                    <Border BorderBrush="#29434F" BorderThickness="1" CornerRadius="12" Margin="0,18,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#162A33" Offset="0"/>
                                <GradientStop Color="#101920" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border Width="3" Margin="0,10" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                            <Grid Margin="15,13,13,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="8" Background="#193945" BorderBrush="#286070" BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="i" Foreground="#7CE5FA" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding [ColorAccuracy]}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#183641" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding [Recommended]}" Foreground="{DynamicResource AccentTextBrush}" FontSize="8" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [AccuracyAdvice]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="SettingsPage" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Panel.ZIndex="50"
              Background="{DynamicResource WindowBrush}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="28,22,28,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

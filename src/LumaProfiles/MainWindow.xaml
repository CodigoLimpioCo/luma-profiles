                </StackPanel>
                <TextBox Grid.Row="1" Margin="0,14,0,12" Style="{StaticResource SearchTextBox}" Tag="{Binding [SearchProfiles]}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [SearchProfiles]}" ToolTip="{Binding [SearchTooltip]}"/>
                <Border Grid.Row="1" Grid.Column="1" Margin="10,14,0,12" Height="38" Padding="3" HorizontalAlignment="Right"
                        Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="19">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewCards, Mode=TwoWay}" ToolTip="{Binding [ViewCards]}" AutomationProperties.Name="{Binding [ViewCards]}"><Viewbox Width="15" Height="15"><Path Data="M1,1H7V7H1Z M9,1H15V7H9Z M1,9H7V15H1Z M9,9H15V15H9Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewLarge, Mode=TwoWay}" ToolTip="{Binding [ViewLarge]}" AutomationProperties.Name="{Binding [ViewLarge]}"><Viewbox Width="15" Height="15"><Path Data="M1,1H7V15H1Z M9,1H15V15H9Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewCompact, Mode=TwoWay}" ToolTip="{Binding [ViewCompact]}" AutomationProperties.Name="{Binding [ViewCompact]}"><Viewbox Width="15" Height="15"><Path Data="M1,1H5V5H1Z M6,1H10V5H6Z M11,1H15V5H11Z M1,6H5V10H1Z M6,6H10V10H6Z M11,6H15V10H11Z M1,11H5V15H1Z M6,11H10V15H6Z M11,11H15V15H11Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewList, Mode=TwoWay}" ToolTip="{Binding [ViewList]}" AutomationProperties.Name="{Binding [ViewList]}"><Viewbox Width="15" Height="15"><Path Data="M1,2.5H3.5V5H1Z M5.5,2.5H15V5H5.5Z M1,7H3.5V9.5H1Z M5.5,7H15V9.5H5.5Z M1,11.5H3.5V14H1Z M5.5,11.5H15V14H5.5Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                        <RadioButton Style="{StaticResource ViewModeButton}" GroupName="ViewMode" IsChecked="{Binding IsViewDetails, Mode=TwoWay}" ToolTip="{Binding [ViewDetails]}" AutomationProperties.Name="{Binding [ViewDetails]}"><Viewbox Width="15" Height="15"><Path Data="M1,1H15V3.5H1Z M1,5.5H15V8H1Z M1,9.5H15V12H1Z M1,13H15V15H1Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Viewbox></RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer x:Name="ProfilesScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="8,0" Margin="0,0,0,6" Height="30">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="Details">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="96"/><ColumnDefinition Width="54"/><ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="60"/><ColumnDefinition Width="46"/><ColumnDefinition Width="156"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Text="{Binding [ColumnProfile]}" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="3" Text="{Binding [ColumnCategory]}" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="4" Text="{Binding [Brightness]}" Style="{StaticResource ColumnHeader}" TextAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding [Contrast]}" Style="{StaticResource ColumnHeader}" TextAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{Binding [Saturation]}" Style="{StaticResource ColumnHeader}" TextAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="{Binding [Gamma]}" Style="{StaticResource ColumnHeader}" TextAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding VisibleProfiles}" Style="{StaticResource ProfilesItemsStyle}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="12,9" Margin="0,6,16,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
        </Grid>

        <Border x:Name="RightInspector" Grid.Row="1" Grid.Column="2" Background="{DynamicResource InspectorBrush}" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,24">
                    <TextBlock Text="{Binding [AdjustProfile]}" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding [CustomizeProfile]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>

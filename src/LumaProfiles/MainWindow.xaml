                        <CheckBox Grid.Column="1" Style="{StaticResource LivePreviewToggle}"
                                  AutomationProperties.Name="{Binding [Schedule]}"
                                  IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="64"/>

<Window x:Class="LumaProfiles.ConfirmationAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [ConfirmTitle]}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Text" Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- A small always-on-top card with just the "keep changes?" question, shown when the main window is hidden,
         minimized or behind other windows. It never takes keyboard focus, so typing or gaming is not interrupted. -->
    <Border Margin="18" Width="440" Padding="18,14,18,12" CornerRadius="16"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
            LayoutTransform="{DynamicResource UiScaleTransform}"
            AutomationProperties.LiveSetting="Assertive">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ConfirmTitle]}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ConfirmDetail, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ConfirmCountdownText, Mode=OneWay}" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding [ConfirmRevert]}" Command="{Binding RevertChangesCommand}"
                            Padding="14,9" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding [ConfirmKeep]}" Command="{Binding KeepChangesCommand}"
                            Padding="16,9"/>
                </StackPanel>
            </Grid>
            <ProgressBar Height="4" Margin="0,12,0,0" Minimum="0" Maximum="{Binding ConfirmTotalSeconds, Mode=OneWay}"
                         Value="{Binding ConfirmRemainingSeconds, Mode=OneWay}" BorderThickness="0"
                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderThemeBrush}"/>
        </StackPanel>
    </Border>
</Window>

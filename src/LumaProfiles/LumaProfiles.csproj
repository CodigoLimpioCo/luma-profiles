<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LumaProfiles</AssemblyName>
    <RootNamespace>LumaProfiles</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LumaProfiles.ico</ApplicationIcon>
    <Version>0.8.1</Version>
    <AssemblyTitle>Luma Profiles</AssemblyTitle>
    <Product>Luma Profiles by Código Limpio</Product>
    <Company>Código Limpio</Company>
    <Authors>Código Limpio</Authors>
    <Description>Biblioteca de perfiles de color para monitores Windows.</Description>
    <Copyright>Copyright © 2026 Código Limpio</Copyright>
    <RepositoryUrl>https://github.com/CodigoLimpioCo/luma-profiles</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and WinForms (used only for NotifyIcon) share type names; keep WPF as the default. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LumaProfiles.Tests" />
    <EmbeddedResource Include="Data\default-profiles.json" LogicalName="LumaProfiles.Data.default-profiles.json" />
    <Resource Include="Assets\color-reference.png" />
    <Resource Include="Assets\CodigoLimpioLogo.png" />
    <Resource Include="Assets\LumaProfiles.ico" />
    <Content Include="Locales\*.lang">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Locales\*.lang" />
  </ItemGroup>
</Project>

                            AutomationProperties.HelpText="{Binding DisplayName}"
                            Command="{Binding DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="4,6" FontSize="11" Content="{Binding DataContext[Apply], RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.HelpText="{Binding DisplayName}"
                            Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ListTemplate">
        <Border Margin="0,0,0,8" Padding="12,9" BorderThickness="1" CornerRadius="12"
                Style="{StaticResource HoverCardBorder}" ToolTip="{Binding DisplayDescription}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{Binding PreviewStart}" Offset="0"/>
                            <GradientStop Color="{Binding PreviewEnd}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="15" Style="{StaticResource ProfileNameText}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                        <Run Text="{Binding DisplayCategory, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding DisplayDescription, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource ChipBrush}" CornerRadius="8" Padding="8,3" Margin="10,0,10,0" VerticalAlignment="Center"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DataContext[Active], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>
                <Button Grid.Column="3" Style="{StaticResource StarButton}" Width="34" Height="34" Margin="0,0,8,0" FontSize="18"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        ToolTip="{Binding DataContext[FavoriteTooltip], RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="{Binding DisplayName}"/>
                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Width="88" Margin="0,0,8,0" Padding="4,8"
                        Content="{Binding DataContext[Adjust], RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.HelpText="{Binding DisplayName}"
                        Command="{Binding DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Button Grid.Column="5" Style="{StaticResource PrimaryButton}" Width="88" Padding="4,8"
                        Content="{Binding DataContext[Apply], RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.HelpText="{Binding DisplayName}"
                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DetailsTemplate">
        <Border Margin="0,0,0,4" Padding="8,0" Height="46" BorderThickness="1" CornerRadius="9"
                Style="{StaticResource HoverCardBorder}" ToolTip="{Binding DisplayDescription}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/><ColumnDefinition Width="54"/><ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="60"/><ColumnDefinition Width="46"/><ColumnDefinition Width="156"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource StarButton}" Width="28" Height="28" HorizontalAlignment="Left"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        ToolTip="{Binding DataContext[FavoriteTooltip], RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="{Binding DisplayName}"/>
                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="7" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{Binding PreviewStart}" Offset="0"/>
                            <GradientStop Color="{Binding PreviewEnd}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource ProfileNameText}"/>
                <TextBlock Grid.Column="3" Text="{Binding DisplayCategory}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="4" Text="{Binding Brightness}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Grid.Column="5" Text="{Binding Contrast}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Grid.Column="6" Text="{Binding Saturation}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Grid.Column="7" Text="{Binding Gamma, StringFormat={}{0:F2}}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Width="74" Padding="4,6" FontSize="12" Margin="0,0,6,0"
                            Content="{Binding DataContext[Adjust], RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.HelpText="{Binding DisplayName}"
                            Command="{Binding DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    <Button Style="{StaticResource PrimaryButton}" Width="74" Padding="4,6" FontSize="12"
                            Content="{Binding DataContext[Apply], RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.HelpText="{Binding DisplayName}"
                            Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="SettingsNavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="10" Padding="12,10" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChoiceButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="12" BorderThickness="1" Padding="10,12"
                            Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderThemeBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentSwatch" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent" MinWidth="54">
                        <Grid Width="36" Height="36" HorizontalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" Opacity="0"/>
                            <Ellipse Margin="4" Fill="{Binding Color}"/>
                        </Grid>
                        <TextBlock Text="{TemplateBinding Content}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.4"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" MinWidth="38" Height="32" CornerRadius="16" Padding="12,0" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IdentifyButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Height="32" CornerRadius="16" Padding="12,0" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Height="30" CornerRadius="15" Padding="13,0" BorderThickness="1"
                            Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderThemeBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Height="38" CornerRadius="19" Padding="16,0" BorderThickness="1"
                            Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderStrongBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ResizeHandle" TargetType="Thumb">
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Line" Width="3" HorizontalAlignment="Center" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource AccentBrush}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ItemsControl" x:Key="ProfilesItemsStyle">
        <Setter Property="ItemsPanel" Value="{StaticResource WrapPanelTemplate}"/>
        <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ViewMode}" Value="Large">
                <Setter Property="ItemTemplate" Value="{StaticResource LargeTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ViewMode}" Value="Compact">
                <Setter Property="ItemTemplate" Value="{StaticResource CompactTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ViewMode}" Value="List">
                <Setter Property="ItemsPanel" Value="{StaticResource StackPanelTemplate}"/>
                <Setter Property="ItemTemplate" Value="{StaticResource ListTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ViewMode}" Value="Details">
                <Setter Property="ItemsPanel" Value="{StaticResource StackPanelTemplate}"/>
                <Setter Property="ItemTemplate" Value="{StaticResource DetailsTemplate}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

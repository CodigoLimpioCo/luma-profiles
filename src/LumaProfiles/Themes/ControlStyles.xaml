                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" AutomationProperties.HelpText="{Binding DisplayName}" Content="{Binding DataContext[Apply], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            </Grid>
        </Grid>

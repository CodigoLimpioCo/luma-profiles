                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="Sat. "/><Run Text="{Binding Saturation}" FontWeight="SemiBold"/></TextBlock>
                    </Border>
                    <Border Background="{DynamicResource ChipBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,5">
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"><Run Text="γ "/><Run Text="{Binding Gamma, StringFormat={}{0:F2}}" FontWeight="SemiBold"/></TextBlock>
                    </Border>
